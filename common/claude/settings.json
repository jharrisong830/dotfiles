{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false
  },
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "permissions": {
    "allow": [
      "Bash(mvn test)",
      "Bash(mvn * test)",
      "Bash(mvn test *)",
      "Bash(mvn * test *)"
    ],
    "defaultMode": "manual"
  }
}
